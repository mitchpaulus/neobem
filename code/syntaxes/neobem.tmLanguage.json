  "name": "Neobem",
  "scopeName": "source.neobem",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#doe2-comment"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#doe2-strings"
    },
    {
      "include": "#language-keywords"
    },
    {
      "include": "#conditionals"
    },
    {
      "include": "#booleans"
    },
    {
