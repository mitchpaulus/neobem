def csharpEscape (str -- str)
    "\\" "\\\\" findReplace
    "\"" "\\\"" findReplace
end

def getDefStr (dict str -- str)
    "" getDef
end

def getDefList (dict str -- [any])
    [] getDef
end

def fieldHasKeys (dict -- bool)
    "keys" [] getDef len 0 >
end

def enumeratedFieldHasKeys ([any] -- bool)
    2unpack field!, fieldIndex!
    @field fieldHasKeys
end

def formatStringArrayLiteral ([str] -- str)
    ("\"" swap csharpEscape + "\"" +) map
    ", " join
    itemsLiteral!
    "new string[] { " @itemsLiteral + " }" +
end

def formatFieldEntry ([any] -- str)
    2unpack keyListNameByLiteral!, fieldRecord!
    @fieldRecord 2unpack field!, zeroBasedIndex!
    @zeroBasedIndex 1 + str position!
    @field "label" getDefStr csharpEscape label!
    @field "keys" getDefList formatStringArrayLiteral keysLiteral!
    @keyListNameByLiteral @keysLiteral "" getDef sharedKeysName!
    $"                [{@position}] = new EnergyPlusFieldKeyDefinition(\"{@label}\", {@sharedKeysName})"
end

def buildKeyListRecord ([any] -- [any])
    2unpack keyLiteral!, groupIndex!
    @groupIndex str groupIndex!
    $"SharedFieldKeys{@groupIndex}" sharedName!
    [ @sharedName @keyLiteral ]
end

def formatKeyListDeclaration ([any] -- str)
    2unpack sharedName!, keyLiteral!
    $"    private static readonly string[] {@sharedName} = {@keyLiteral};"
end

def formatObjectMethod ([any] -- str)
    2unpack keyListNameByLiteral!, objectRecord!
    @objectRecord 2unpack object!, objectIndex!
    @objectIndex str objectIndex!
    @object "fields" getDefList fieldList!
    @fieldList enumerate (enumeratedFieldHasKeys) filter fieldHasCompletionKeys!
    @fieldHasCompletionKeys (@keyListNameByLiteral swap 2tuple formatFieldEntry) map ",\n" join fieldEntries!
    [
        $"        private static EnergyPlusObjectFieldKeyMap Object{@objectIndex}() => new EnergyPlusObjectFieldKeyMap(new Dictionary<int, EnergyPlusFieldKeyDefinition>"
        "        {"
        @fieldEntries
        "        });"
    ] unlines
end

def formatObjectRegistration ([any] -- str)
    2unpack object!, objectIndex!
    @objectIndex str objectIndex!
    @object "name" getDefStr csharpEscape objectName!
    $"            d[\"{@objectName}\"] = Object{@objectIndex}();"
end

args args!
@args len argCount!

@argCount 0 > if
    @args :0: toPath inputPath!
else
    `src/25.2_Energy+.json` inputPath!
end

@argCount 1 > if
    @args :1: toPath schemaPath!
else
    `src/energyplus-idd.schema.json` schemaPath!
end

@argCount 2 > if
    @args :2: toPath outputPath!
else
    `src/EnergyPlusFieldKeyData.g.cs` outputPath!
end

@schemaPath fileExists not if
    $"Schema file not found: {@schemaPath}" wle
    1 exit
end

@inputPath parseJson idd!
@idd "iddVersion" getDefStr iddVersion!
@idd "objects" getDefList objects!
@objects ("fields" getDefList (fieldHasKeys) any) filter objectsWithKeyedFields!
@objectsWithKeyedFields ("fields" getDefList (fieldHasKeys) filter) map concat allKeyedFields!
@allKeyedFields ("keys" getDefList formatStringArrayLiteral) map uniq enumerate (buildKeyListRecord) map sharedKeyRecords!
@sharedKeyRecords (:1:) (:0:) listToDict keyListNameByLiteral!
@sharedKeyRecords (formatKeyListDeclaration) map unlines sharedKeyDeclarations!
@objectsWithKeyedFields enumerate enumeratedObjects!
@enumeratedObjects (@keyListNameByLiteral swap 2tuple formatObjectMethod) map "\n\n" join objectMethods!
@enumeratedObjects (formatObjectRegistration) map unlines objectRegistrations!
    "    public const string IddVersion = \"" iddVersionPrefix!
@iddVersionPrefix @iddVersion + "\";" + iddVersionLine!
[
    "// <auto-generated />"
    "using System;"
    "using System.Collections.Generic;"
    ""
    "namespace src;"
    ""
    "internal sealed record EnergyPlusFieldKeyDefinition(string Label, IReadOnlyList<string> Keys);"
    ""
    "internal sealed record EnergyPlusObjectFieldKeyMap(IReadOnlyDictionary<int, EnergyPlusFieldKeyDefinition> FieldsByPosition);"
    ""
    "internal static class EnergyPlusFieldKeyData"
    "{"
    @iddVersionLine
    ""
    @sharedKeyDeclarations
    ""
    "    public static readonly IReadOnlyDictionary<string, EnergyPlusObjectFieldKeyMap> Objects = BuildObjects();"
    ""
    "    private static IReadOnlyDictionary<string, EnergyPlusObjectFieldKeyMap> BuildObjects()"
    "    {"
    "        var d = new Dictionary<string, EnergyPlusObjectFieldKeyMap>(StringComparer.OrdinalIgnoreCase);"
    @objectRegistrations
    "        return d;"
    "    }"
    ""
    @objectMethods
    "}"
] unlines @outputPath writeFile
