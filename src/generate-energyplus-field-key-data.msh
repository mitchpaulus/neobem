def csharpEscape (str -- str)
    "\\" "\\\\" findReplace
    "\"" "\\\"" findReplace
end

def getDefStr (dict str -- str)
    "" getDef
end

def getDefList (dict str -- [any])
    [] getDef
end

def fieldHasKeys (dict -- bool)
    "keys" [] getDef len 0 >
end

def formatStringArrayLiteral ([str] -- str)
    ("\"" swap csharpEscape + "\"" +) map
    ", " join
    itemsLiteral!
    "new string[] { " @itemsLiteral + " }" +
end

def formatFieldEntry (dict -- str)
    field!
    @field "position" 0 getDef str position!
    @field "label" getDefStr csharpEscape label!
    @field "keys" getDefList formatStringArrayLiteral keysLiteral!
    $"                [{@position}] = new EnergyPlusFieldKeyDefinition(\"{@label}\", {@keysLiteral})"
end

def formatObjectEntry (dict -- str)
    object!
    @object "name" getDefStr csharpEscape objectName!
    @object "fields" getDefList fieldList!
    @fieldList (fieldHasKeys) filter fieldHasCompletionKeys!
    @fieldHasCompletionKeys (formatFieldEntry) map ",\n" join fieldEntries!
    $"        [\"{@objectName}\"] = new EnergyPlusObjectFieldKeyMap(new Dictionary<int, EnergyPlusFieldKeyDefinition>" objectHeader!
    [
        @objectHeader
        "        {"
        @fieldEntries
        "        })"
    ] "\n" join
end

args args!
@args len argCount!

@argCount 0 > if
    @args 0 nth toPath inputPath!
else
    `src/25.2_Energy+.json` inputPath!
end

@argCount 1 > if
    @args 1 nth toPath schemaPath!
else
    `src/energyplus-idd.schema.json` schemaPath!
end

@argCount 2 > if
    @args 2 nth toPath outputPath!
else
    `src/EnergyPlusFieldKeyData.g.cs` outputPath!
end

@schemaPath fileExists not if
    $"Schema file not found: {@schemaPath}" wle
    1 exit
end

@inputPath parseJson idd!
@idd "iddVersion" getDefStr iddVersion!
@idd "objects" getDefList objects!
@objects ("fields" getDefList (fieldHasKeys) any) filter objectsWithKeyedFields!
@objectsWithKeyedFields (formatObjectEntry) map ",\n" join objectEntries!
"    public const string IddVersion = \"" iddVersionPrefix!
@iddVersionPrefix @iddVersion + "\";" + iddVersionLine!
[
    "// <auto-generated />"
    "using System;"
    "using System.Collections.Generic;"
    ""
    "namespace src;"
    ""
    "internal sealed record EnergyPlusFieldKeyDefinition(string Label, IReadOnlyList<string> Keys);"
    ""
    "internal sealed record EnergyPlusObjectFieldKeyMap(IReadOnlyDictionary<int, EnergyPlusFieldKeyDefinition> FieldsByPosition);"
    ""
    "internal static class EnergyPlusFieldKeyData"
    "{"
    @iddVersionLine
    ""
    "    public static readonly IReadOnlyDictionary<string, EnergyPlusObjectFieldKeyMap> Objects ="
    "        new Dictionary<string, EnergyPlusObjectFieldKeyMap>(StringComparer.OrdinalIgnoreCase)"
    "        {"
    @objectEntries
    "        };"
    "}"
] "\n" join @outputPath writeFile
